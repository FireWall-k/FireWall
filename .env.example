# JOB CARD Docker/local environment sample
# AAC는 ARASAAC, TTS는 Google Cloud Text-to-Speech를 기본으로 사용합니다.

# Backend -> AI harness
AI_BASE_URL=http://ai_service:8001
AI_TIMEOUT=15

# SQLite inside backend container. Host persistence path is ./backend/data/jobcard.db
DATABASE_URL=sqlite:////app/data/jobcard.db

# Browser origins allowed by backend CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend build-time API base URL used by Vite
VITE_API_BASE=http://localhost:8000
PUBLIC_BACKEND_URL=http://localhost:8000

# AAC: project-owned local dataset
AAC_DATA_DIR=/app/aac
AAC_MATCH_THRESHOLD=0.22
# 1순위와 2순위의 점수 차가 이보다 작으면 채택하지 않는다(동점 후보 중 임의 선택 방지)
AAC_MATCH_MIN_MARGIN=0.02
# 임베딩 가산 항: 임베딩을 쓴 검색은 아래 임계값으로 판정한다(위 기본값은 임베딩이 없을 때).
AAC_EMBEDDINGS=auto
AAC_EMBED_MATCH_THRESHOLD=0.35
AAC_EMBED_MATCH_MIN_MARGIN=0.02
AAC_EMBED_TIMEOUT=3

# TTS: Google Cloud Text-to-Speech
# 서비스 계정 JSON을 프로젝트 루트의 secrets/google-tts.json으로 저장하세요.
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-tts.json
GOOGLE_TTS_LANGUAGE=ko-KR
GOOGLE_TTS_VOICE=ko-KR-Standard-A
GOOGLE_TTS_SPEAKING_RATE=0.9
GOOGLE_TTS_PITCH=0
TTS_CACHE_DIR=/app/data/tts

# --- OpenAI (LLM) ---
# 설정하면 맥락적응 직무 분해 + 사업주 AI 코칭이 활성화됩니다.
# 미설정 시 규칙 기반/휴리스틱으로 자동 폴백합니다(서비스는 정상 동작).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=20

# --- 단계별 사진 업로드 ---
PHOTO_DIR=./data/photos
MAX_PHOTO_BYTES=5242880
# 디컴프레션 폭탄 방어: 이 픽셀 수(가로x세로)를 넘는 사진은 디코딩 전에 거부한다. 48MP 휴대폰 사진까지 받는다.
MAX_PHOTO_PIXELS=50000000
# 사진·TTS 서명 URL 수명(초). 만료되면 화면이 다시 조회해 새 URL을 받는다. 짧을수록 새어 나간 URL의 위험이 작다.
MEDIA_URL_TTL_SECONDS=3600
# 레코드 없는 사진·TTS 파일과 어느 단계도 쓰지 않는 레코드를 지우기 전 유예시간(purge / manage.py gc-media).
MEDIA_ORPHAN_GRACE_HOURS=24

# --- 운영 배포 (docker-compose가 읽는다) ---
# 로컬 개발은 비워 둬도 된다. 운영 서버에서는 아래를 반드시 채운다(README '운영 배포' 참고).
# prod: 약한 시크릿이면 기동 실패 + 데모 계정(demo/demo1234) 미생성
JOBCARD_ENV=dev
# 32자 이상 무작위 값. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 근로자 접속 코드도 이 키로 해시해 저장한다. 키를 바꾸면 기존 접속 코드가 모두 맞지 않게 되므로
# 근로자 관리 화면에서 접속 코드를 전부 다시 만들어야 한다(토큰도 모두 무효가 된다).
JOBCARD_SECRET=
# 1이면 운영에서도 데모 계정을 만든다(시연용 서버에서만)
DEMO_SEED=
# 데모 사업장 코드(근로자 로그인 화면에서 처음 한 번 입력). 비우면 DEMO01
DEMO_WORKPLACE_CODE=
# HTTPS 리버스 프록시 뒤라면 1 (로그인 시도 제한이 실제 접속자 IP를 보게)
TRUST_FORWARDED_FOR=0
# 운영 도메인 예시
# CORS_ORIGINS=https://jobcard.example.kr
# PUBLIC_BACKEND_URL=https://api.jobcard.example.kr
# VITE_API_BASE=https://api.jobcard.example.kr

# --- 개인정보 보존·삭제 (docs/privacy/data-map.md) ---
# `docker compose --profile maintenance run --rm purge`를 하루 한 번 cron으로 돌린다.
# 수행 로그(소요시간·다시듣기·막힘) 보존 일수
PERFORMANCE_LOG_RETENTION_DAYS=365
# 접근 감사 로그 보존 일수. 민감정보 처리 시스템의 접속기록은 2년 이상(안전성 확보조치 기준 제8조)
ACCESS_AUDIT_RETENTION_DAYS=730
# 어느 단계도 쓰지 않는 TTS mp3를 지우기 전 유예(시간)
TTS_ORPHAN_GRACE_HOURS=24
# 동의 기록에 함께 남는 개인정보 처리방침 버전
PRIVACY_POLICY_VERSION=2026-11-07-draft
