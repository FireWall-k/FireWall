# 잡카드(JobCard) 환경 설정 예시 — 이 파일을 .env로 복사해 쓴다(.env는 .gitignore 대상).
# 여기에는 실제 값을 절대 적지 않는다. docker compose는 같은 폴더의 .env를 읽어 docker-compose.yml의
# ${변수}를 채운다. 로컬 개발(uvicorn 직접 실행)에서는 셸 환경변수로 넣는다.
#
# ★ 비밀값(OpenAI 키, JOBCARD_SECRET, Google 서비스 계정 JSON)은 .env가 아니라 secrets/ 파일에 둔다.
#   - 처음 한 번: sh scripts/init-secrets.sh  (Windows: powershell -File scripts\init-secrets.ps1)
#   - compose가 Docker secrets로 컨테이너의 /run/secrets/<이름>에 넘기고, 앱은 <이름>_FILE 경로에서 읽는다.
#   - 이유·우선순위·교체 절차: docs/security/secrets.md
#   .env는 로그·백업·클라우드 동기화(OneDrive 등)로 새기 쉽고, 환경변수 값은 docker inspect에 그대로 보인다.

# =====================================================================
# 비밀값 — 파일 경로(<이름>_FILE). compose는 아래 값을 자동으로 넣으므로 .env에 적을 필요 없다.
# 로컬 개발에서 파일로 주고 싶을 때만 쓴다. 파일 값이 환경변수 직접 값보다 우선한다.
# 경로를 줬는데 파일이 없으면 기동이 실패한다(오타를 개발용 기본 키로 덮지 않게). 빈 파일이면 아래 직접 값을 쓴다.
# =====================================================================
# OpenAI API 키 파일(ai_service). compose: /run/secrets/openai_api_key ← secrets/openai_api_key.txt
# OPENAI_API_KEY_FILE=
# 토큰·접속 코드 해시·서명 URL 서명 키 파일(backend/migrate/purge). compose: /run/secrets/jobcard_secret ← secrets/jobcard_secret.txt
# JOBCARD_SECRET_FILE=
# Google 서비스 계정 JSON 경로(backend). compose: /run/secrets/google_tts_credentials ← secrets/google-tts.json
# 비어 있는 파일이면 ADC(Workload Identity 등)를 쓴다. 로컬 예: ../secrets/google-tts.json
# GOOGLE_APPLICATION_CREDENTIALS=

# --- 비밀값 직접 값(하위호환, 로컬 개발용) ---------------------------
# 위 *_FILE이 없거나 그 파일이 비어 있을 때만 쓰인다. 운영에서는 비워 두고 secrets/ 파일을 쓴다.
# OpenAI 키. 비우면 규칙 기반/휴리스틱으로 자동 폴백(서비스는 정상 동작).
OPENAI_API_KEY=
# 32자 이상 무작위 값. 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
# 근로자 접속 코드도 이 키로 해시해 저장한다. 키를 바꾸면 기존 접속 코드·토큰·서명 URL이 모두 무효가 되므로
# 근로자 관리 화면에서 접속 코드를 전부 다시 만들어야 한다. 이미 쓰던 값이 있으면 새로 만들지 말고 파일로 옮긴다.
JOBCARD_SECRET=

# =====================================================================
# 실행 환경
# =====================================================================
# dev | prod. prod: 약한/빈 JOBCARD_SECRET이면 기동 실패 + 데모 계정(demo/demo1234) 미생성
JOBCARD_ENV=dev
# 토큰 수명(초). 기본 86400(1일)
JOBCARD_TOKEN_TTL=86400
# 1이면 운영에서도 데모 계정을 만든다(시연용 서버에서만)
DEMO_SEED=
# 데모 계정(dev에서 자동 생성). 운영에서는 쓰지 않는다.
DEMO_EMPLOYER_LOGIN=demo
DEMO_EMPLOYER_PASSWORD=demo1234
DEMO_WORKER_CODE=1234
# 데모 사업장 코드(근로자 로그인 화면에서 처음 한 번 입력). 비우면 DEMO01
DEMO_WORKPLACE_CODE=
# 날짜 집계·"오늘"의 기준 시간대(UTC 기준 시차). 한국 9
APP_UTC_OFFSET_HOURS=9

# =====================================================================
# 네트워크·주소
# =====================================================================
# backend → AI 하네스 주소와 타임아웃(초). LLM 분해는 10초 이상 걸릴 수 있다(compose는 30).
AI_BASE_URL=http://ai_service:8001
AI_TIMEOUT=15
# 브라우저 출처(CORS) 허용 목록, 쉼표 구분
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 프론트엔드 빌드 시 API 주소(Vite, 빌드 인자)
VITE_API_BASE=http://localhost:8000
# 백엔드 공개 주소(그림 URL 검증·생성 기준)
PUBLIC_BACKEND_URL=http://localhost:8000
# HTTPS 리버스 프록시 뒤라면 1 (로그인 시도 제한이 실제 접속자 IP를 보게)
TRUST_FORWARDED_FOR=0
# 운영 도메인 예시
# CORS_ORIGINS=https://jobcard.example.kr
# PUBLIC_BACKEND_URL=https://api.jobcard.example.kr
# VITE_API_BASE=https://api.jobcard.example.kr

# =====================================================================
# 저장소
# =====================================================================
# SQLite. 컨테이너 안 경로(named volume jobcard-data)
DATABASE_URL=sqlite:////app/data/jobcard.db
# 단계별 사진 저장 경로와 최대 크기(바이트)
PHOTO_DIR=./data/photos
MAX_PHOTO_BYTES=5242880
# 디컴프레션 폭탄 방어: 이 픽셀 수(가로x세로)를 넘는 사진은 디코딩 전에 거부한다. 48MP 휴대폰 사진까지 받는다.
MAX_PHOTO_PIXELS=50000000
# 사진·TTS 서명 URL 수명(초). 만료되면 화면이 다시 조회해 새 URL을 받는다. 짧을수록 새어 나간 URL의 위험이 작다.
MEDIA_URL_TTL_SECONDS=3600
# 레코드 없는 사진·TTS 파일과 어느 단계도 쓰지 않는 레코드를 지우기 전 유예시간(purge / manage.py gc-media).
MEDIA_ORPHAN_GRACE_HOURS=24
# 직무 생성 시 단계별 TTS·그림 준비를 병렬로 돌리는 스레드 수
STEP_PREP_WORKERS=8

# =====================================================================
# 로그인 시도 제한(backend/ratelimit.py)
# =====================================================================
# 사업주: 창(초) 안에서 실패 허용 횟수
LOGIN_MAX_FAILURES=10
LOGIN_WINDOW_SEC=900
# 근로자: 같은 사업장 IP를 여럿이 쓰므로 더 넉넉히
WORKER_LOGIN_MAX_FAILURES=30
WORKER_LOGIN_WINDOW_SEC=600

# =====================================================================
# AAC 그림 매칭(ai_service)
# =====================================================================
# 자체 AAC 데이터 경로. 로컬 실행 시에는 비워 두면 저장소의 data/aac를 쓴다.
AAC_DATA_DIR=/app/aac
AAC_MATCH_THRESHOLD=0.215
# 1순위와 (같은 그림 묶음 밖) 경쟁 후보의 점수 차가 이보다 작으면 채택하지 않는다(동점 후보 중 임의 선택 방지)
AAC_MATCH_MIN_MARGIN=0.018
# 여유 방식: absolute(s1−s2 ≥ MIN_MARGIN, 기본) | relative((s1−s2)/s1 ≥ MIN_REL_MARGIN). 임베딩 쪽은 AAC_EMBED_MATCH_*
AAC_MATCH_MARGIN_MODE=absolute
AAC_MATCH_MIN_REL_MARGIN=0.06
# 직무만 다르고 라벨·frame이 같은 그림을 여유 판정에서 한 묶음으로 볼지(on|off). 복장·배경 차이 때문에 기본 off
AAC_MATCH_CROSS_JOB_TWINS=off
# 임베딩 가산 항: auto(제공자를 쓸 수 있고 자산 임베딩 파일이 맞으면 켬) | off.
AAC_EMBEDDINGS=auto
# 제공자: local(기본, 무료 로컬 모델·키 불필요) | openai(text-embedding-3-large, 키 필요).
# 바꾸면 scripts/build_aac_embeddings.py로 data/aac/aac_embeddings.npz를 같은 제공자로 다시 만든다.
AAC_EMBED_PROVIDER=local
# 로컬 모델(fastembed 이름)과 모델 캐시 폴더. 도커 이미지는 빌드 때 /opt/embed-models에 받아 둔다.
# 비우면 paraphrase-multilingual-MiniLM-L12-v2 / fastembed 기본 캐시.
AAC_LOCAL_EMBED_MODEL=
AAC_EMBED_CACHE_DIR=
# 로컬 모델 추론 스레드 수
AAC_LOCAL_EMBED_THREADS=2
# 임베딩을 쓴 검색의 채택 임계값·여유. 비우면 제공자별 기본값(local 0.24/0.015, openai 0.35/0.02)
AAC_EMBED_MATCH_THRESHOLD=
AAC_EMBED_MATCH_MIN_MARGIN=
# 질의 임베딩 호출 타임아웃(초, openai)과 실패 후 재시도 대기(초)
AAC_EMBED_TIMEOUT=3
AAC_EMBED_COOLDOWN=60
# 임베딩 점수 가중치와 기준값(점수 = 규칙 + WEIGHT * max(0, 유사도 - BASE)).
# 비우면 제공자별 기본값(local 0.3/0.65, openai 0.5/0.4)
AAC_EMBED_WEIGHT=
AAC_EMBED_BASE=

# =====================================================================
# OpenAI(LLM) — 키는 위 "비밀값" 참고
# =====================================================================
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# 채팅 호출 타임아웃(초)
LLM_TIMEOUT=20
# AAC_EMBED_PROVIDER=openai일 때의 임베딩 모델과 차원(data/aac/aac_embeddings.npz를 만들 때와 같아야 한다)
OPENAI_EMBED_MODEL=text-embedding-3-large
OPENAI_EMBED_DIMS=256

# =====================================================================
# TTS: Google Cloud Text-to-Speech — 자격증명은 위 "비밀값" 참고
# =====================================================================
GOOGLE_TTS_LANGUAGE=ko-KR
GOOGLE_TTS_VOICE=ko-KR-Standard-A
GOOGLE_TTS_SPEAKING_RATE=0.9
GOOGLE_TTS_PITCH=0
TTS_CACHE_DIR=/app/data/tts
# 합성이 실패하면 이 시간(초) 동안 다시 시도하지 않는다(설정 오류가 단계마다 지연을 만들지 않게)
TTS_FAILURE_COOLDOWN=300

# =====================================================================
# 개인정보 보존·삭제 (docs/privacy/data-map.md)
# `docker compose --profile maintenance run --rm purge`를 하루 한 번 cron으로 돌린다.
# =====================================================================
# 수행 로그(소요시간·다시듣기·막힘) 보존 일수
PERFORMANCE_LOG_RETENTION_DAYS=365
# 접근 감사 로그 보존 일수. 민감정보 처리 시스템의 접속기록은 2년 이상(안전성 확보조치 기준 제8조)
ACCESS_AUDIT_RETENTION_DAYS=730
# 같은 사람의 같은 조회를 이 시간(초) 안에서는 감사 로그 한 건으로 묶는다
ACCESS_AUDIT_DEDUPE_SECONDS=60
# 어느 단계도 쓰지 않는 TTS mp3를 지우기 전 유예(시간). MEDIA_ORPHAN_GRACE_HOURS가 비면 이 값을 쓴다.
TTS_ORPHAN_GRACE_HOURS=24
# 동의 기록에 함께 남는 개인정보 처리방침 버전
PRIVACY_POLICY_VERSION=2026-11-07-draft
