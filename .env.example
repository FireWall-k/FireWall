# JOB CARD Docker/local environment sample
# AAC는 ARASAAC, TTS는 Google Cloud Text-to-Speech를 기본으로 사용합니다.

# Backend -> AI harness
AI_BASE_URL=http://ai_service:8001
AI_TIMEOUT=15

# SQLite inside backend container. Host persistence path is ./backend/data/jobcard.db
DATABASE_URL=sqlite:////app/data/jobcard.db

# Browser origins allowed by backend CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend build-time API base URL used by Vite
VITE_API_BASE=http://localhost:8000
PUBLIC_BACKEND_URL=http://localhost:8000

# AAC: ARASAAC
ARASAAC_API_BASE=https://api.arasaac.org
ARASAAC_LANGS=ko,en,es
ARASAAC_SEARCH_TIMEOUT=1.5
ARASAAC_KEYWORD_SEARCH_LIMIT=4
ARASAAC_TERM_SEARCH_LIMIT=3

# TTS: Google Cloud Text-to-Speech
# 서비스 계정 JSON을 프로젝트 루트의 secrets/google-tts.json으로 저장하세요.
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-tts.json
GOOGLE_TTS_LANGUAGE=ko-KR
GOOGLE_TTS_VOICE=ko-KR-Standard-A
GOOGLE_TTS_SPEAKING_RATE=0.9
GOOGLE_TTS_PITCH=0
TTS_CACHE_DIR=/app/data/tts

# --- OpenAI (LLM) ---
# 설정하면 맥락적응 직무 분해 + 사업주 AI 코칭이 활성화됩니다.
# 미설정 시 규칙 기반/휴리스틱으로 자동 폴백합니다(서비스는 정상 동작).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=20

# --- 단계별 사진 업로드 ---
PHOTO_DIR=./data/photos
MAX_PHOTO_BYTES=5242880
